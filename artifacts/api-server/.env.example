# ─────────────────────────────────────────────────────────
# EverydayTools API Server — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────

# Node environment (development | production)
NODE_ENV=production

# Port the Express server listens on
PORT=3001

# Frontend origin allowed by CORS (no trailing slash)
# In production: your Vercel / static hosting URL
FRONTEND_URL=https://everydaytools.qzz.io

# Logging level (trace | debug | info | warn | error | fatal)
# Optional — defaults to "info" in production, "debug" in development
# LOG_LEVEL=info

# ─── Rate limiting ────────────────────────────────────────
# Window duration in milliseconds (default: 60000 = 1 minute)
# RATE_LIMIT_WINDOW_MS=60000

# ─── File size limits ─────────────────────────────────────
# Maximum single-file upload size in MB (default: 50)
# MAX_FILE_SIZE_MB=50

# ─── System binary paths (optional — defaults resolve via PATH) ───
# Override if binaries are not on PATH or installed in non-standard locations.
# SOFFICE_PATH=/usr/bin/soffice
# GS_PATH=/usr/bin/gs
# POTRACE_PATH=/usr/bin/potrace
# QPDF_PATH=/usr/bin/qpdf
# PYTHON3_PATH=/usr/bin/python3
# TESSERACT_PATH=/usr/bin/tesseract
