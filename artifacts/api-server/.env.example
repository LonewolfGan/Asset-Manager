# ─────────────────────────────────────────────────────────────────────────────
# EverydayTools API Server — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Node environment (development | production)
NODE_ENV=production

# Port the Express server listens on
PORT=3001

# Frontend origin allowed by CORS (no trailing slash)
FRONTEND_URL=https://everydaytools.qzz.io

# ─── System binary paths ─────────────────────────────────────────────────────
# Override if binaries are installed in non-standard locations.
# All binaries default to bare command names (resolved via PATH).
LIBREOFFICE_PATH=/usr/bin/soffice
GHOSTSCRIPT_PATH=/usr/bin/gs
POTRACE_PATH=/usr/bin/potrace
QPDF_PATH=/usr/bin/qpdf
PYTHON_PATH=/usr/bin/python3
TESSERACT_PATH=/usr/bin/tesseract

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Window duration in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ─── File size limits ─────────────────────────────────────────────────────────
# Maximum single-file upload size in MB (default: 50)
MAX_FILE_SIZE_MB=50

# ─── Exchange rates (currency converter) ──────────────────────────────────────
# Optional: open.er-api.com is used directly by default, no key needed for basic usage.
# EXCHANGE_RATE_API_KEY=your_key_here

# ─── Logging ─────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info
