# Copy to .env.local for local development
# Set these in Vercel → Project → Settings → Environment Variables for production

# Google AdSense publisher ID  (format: ca-pub-XXXXXXXXXXXXXXXXX)
# Get this from your AdSense account after approval
VITE_ADSENSE_PUBLISHER_ID=

# Plausible domain  (must match the domain configured in your Plausible account)
VITE_PLAUSIBLE_DOMAIN=everydaytoolshub.com

# ── API Server (Oracle VM) ──────────────────────────────────────────────────
# URL of the backend API — set on Oracle VM, not on Vercel
# Comma-separated list of allowed frontend origins (e.g. Vercel URL + custom domain)
FRONTEND_URL=https://everydaytools.qzz.io
# Extra origins to allow in CORS (comma-separated, optional)
CORS_EXTRA_ORIGINS=
# Absolute path to the Python scripts directory inside the Docker container
PYTHON_SCRIPTS_DIR=/app/python

# ── Frontend (Vercel) ───────────────────────────────────────────────────────
# URL of the Oracle VM backend — set in Vercel environment variables
VITE_API_URL=https://api.everydaytools.qzz.io
