# Copy to .env.local for local development
# Set these in Vercel → Project → Settings → Environment Variables for production

# Google AdSense publisher ID  (format: ca-pub-XXXXXXXXXXXXXXXXX)
# Get this from your AdSense account after approval
VITE_ADSENSE_PUBLISHER_ID=

# Plausible domain  (must match the domain configured in your Plausible account)
VITE_PLAUSIBLE_DOMAIN=everydaytoolshub.com
